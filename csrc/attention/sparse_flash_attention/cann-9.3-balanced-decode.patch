+template <typename CubeBlockType, typename VecBlockType>
+__aicore__ inline void SparseFlashAttentionKernelMla<CubeBlockType, VecBlockType>::ProcessBalancedDecode()
+{
+    using namespace SFABalancedDecode;
+    constexpr uint32_t RING_SIZE = 3;
+    RunInfo tiles[RING_SIZE]{};
+    uint32_t partialSlots[RING_SIZE]{};
+    bool retainedPartials[RING_SIZE]{};
+    uint32_t residentStatsBank = 0;
+    RunParamStr fragment{};
+    const uint32_t coreCapacity = TilesPerCore(balancedQueries);
+    const uint64_t workSize = static_cast<uint64_t>(balancedQueries) * TILES_PER_QUERY;
+    const uint64_t firstWork = Min(static_cast<uint64_t>(aicIdx) * coreCapacity, workSize);
+    const uint64_t endWork = Min(firstWork + coreCapacity, workSize);
+    const uint32_t tilesPerCore = endWork - firstWork;
+    uint32_t firstTile = 0;
+    uint32_t tileCount = 0;
+    uint32_t fragmentNumber = 0;
+    uint32_t batch = 0;
+    uint32_t batchStart = 0;
+    uint32_t batchEnd = actualSeqQlenAddr[0];
+    for (uint32_t task = 0; task < tilesPerCore + PRELOAD_NUM; ++task) {
+        if (task < tilesPerCore) {
+            const uint64_t work = firstWork + task;
+            const uint32_t query = work / TILES_PER_QUERY;
+            const uint32_t queryTile = work % TILES_PER_QUERY;
+            if (task == 0 || queryTile == 0) {
+                firstTile = queryTile;
+                tileCount = Min(TILES_PER_QUERY - firstTile, endWork - work);
+                ++fragmentNumber;
+                while (query >= batchEnd) {
+                    batchStart = batchEnd;
+                    batchEnd = actualSeqQlenAddr[++batch];
+                }
+                fragment.boIdx = batch;
+                fragment.n2oIdx = 0;
+                fragment.qSNumInOneBlock = 1;
+                ComputeParamBatch<TEMPLATE_INTF_ARGS>(fragment, sfaConstInfo, actualSeqQlenAddr, actualSeqKvlenAddr);
+                const uint32_t queryInBatch = query - batchStart;
+                ComputeAxisIdxByBnAndGs1(fragment.boIdx, queryInBatch, fragment);
+                ComputeParamS1<TEMPLATE_INTF_ARGS>(fragment, sfaConstInfo, queryInBatch, actualSeqQlenAddr);
+                fragment.s2LineStartIdx = 0;
+                fragment.s2LineEndIdx = tileCount * TILE_ROWS;
+                fragment.kvLoopEndIdx = tileCount;
+                fragment.s2LoopEndIdx = tileCount;
+            }
+            const uint32_t ring = task % RING_SIZE;
+            RunInfo& info = tiles[ring];
+            SetRunInfo(info, fragment, task, queryTile - firstTile, tileCount - 1, fragmentNumber);
+            const uint32_t firstOwner = static_cast<uint64_t>(query) * TILES_PER_QUERY / coreCapacity;
+            const uint32_t lastOwner = (static_cast<uint64_t>(query + 1) * TILES_PER_QUERY - 1) / coreCapacity;
+            const uint32_t part = aicIdx - firstOwner;
+            retainedPartials[ring] = part == 0 && lastOwner != firstOwner;
+            if (retainedPartials[ring]) {
+                residentStatsBank = info.multiCoreIdxMod2;
+            } else {
+                partialSlots[ring] = part == 0 ? UINT32_MAX : RemotePartialSlot(aicIdx, coreCapacity);
+            }
+            if ASCEND_IS_AIC {
+                cubeBlock.IterateBmm1(bmm1Buffers.Get(), l1RightBuffers.Get(), v0ResGmBuffers.Get(), info,
+                                      sfaConstInfo, true);
+            } else {
+                vecBlock.ProcessVec0(l1RightBuffers.Get(), v0ResGmBuffers.Get(), info, sfaConstInfo, true, firstTile);
+            }
+        }
+        if (task > 0 && task <= tilesPerCore) {
+            RunInfo& info = tiles[(task - 1) % RING_SIZE];
+            if ASCEND_IS_AIV {
+                vecBlock.ProcessVec1(l1RightBuffers.GetReused(), bmm1Buffers.Get(), info, sfaConstInfo);
+            } else {
+                cubeBlock.IterateBmm2(bmm2Buffers.Get(), l1RightBuffers, l1RightBuffers.GetReused(), info, sfaConstInfo);
+            }
+        }
+        if (task > 1) {
+            if ASCEND_IS_AIV {
+                const uint32_t ring = (task - 2) % RING_SIZE;
+                vecBlock.ProcessVec2(bmm2Buffers.Get(), tiles[ring], sfaConstInfo,
+                                     retainedPartials[ring] || partialSlots[ring] == UINT32_MAX ? nullptr : balancedPartials,
+                                     partialSlots[ring], retainedPartials[ring]);
+            }
+        }
+    }
+    if ASCEND_IS_AIV {
+        vecBlock.FinishBalancedPartial();
+        SyncAll();
+        // Whole queries were written directly. Only the final split query can
+        // belong to this core and still require a peer result.
+        if (tilesPerCore != 0) {
+            const uint32_t query = (endWork - 1) / TILES_PER_QUERY;
+            const uint32_t firstOwner = static_cast<uint64_t>(query) * TILES_PER_QUERY / coreCapacity;
+            const uint32_t lastOwner = (static_cast<uint64_t>(query + 1) * TILES_PER_QUERY - 1) / coreCapacity;
+            if (firstOwner == aicIdx && lastOwner != aicIdx) {
+                vecBlock.MergeBalancedQuery(balancedPartials, query, sfaConstInfo, coreCapacity,
+                                            lastOwner - aicIdx + 1, residentStatsBank, bmm2Buffers.Get());
+            }
+        }
+    }
+}
