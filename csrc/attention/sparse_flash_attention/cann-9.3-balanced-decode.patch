+template <typename CubeBlockType, typename VecBlockType>
+__aicore__ inline bool SparseFlashAttentionKernelMla<CubeBlockType, VecBlockType>::CanWriteKvToL1(
+    const RunInfo& runInfo)
+{
+    using VectorImplementation = SFAVectorService<TEMPLATE_INTF_ARGS>;
+    if constexpr (VectorImplementation::CAN_USE_DIRECT_KV_L1) {
+        if (actualSeqQlenAddr == nullptr || sparseIndicesAddr == nullptr ||
+            sharedParams.gSize != sfaConstInfo.s1BaseSize || sharedParams.s1Size <= sfaConstInfo.s1BaseSize / 2 ||
+            sharedParams.n2Size != 1 || sharedParams.blockSize != VectorImplementation::KV_PAGE_SIZE ||
+            sfaConstInfo.sparseBlockSize != 1 || sfaConstInfo.sparseMode != 3 ||
+            runInfo.s2RealSize != sfaConstInfo.s2BaseSize || runInfo.s2StartIdx != 0) {
+            return false;
+        }
+        const int64_t lastCol = (runInfo.s2LoopCount + 1) * sfaConstInfo.s2BaseSize - 1;
+        if (lastCol >= sfaConstInfo.sparseBlockCount) {
+            return false;
+        }
+        // A packed index row has one valid prefix and an optional -1 tail.
+        const int64_t batchStart = runInfo.boIdx == 0 ? 0 : actualSeqQlenAddr[runInfo.boIdx - 1];
+        const int64_t row = batchStart + runInfo.s1oIdx;
+        return sparseIndicesAddr[row * sfaConstInfo.sparseBlockCount + lastCol] >= 0;
+    }
+    return false;
+}
