+template <typename CubeBlockType, typename VecBlockType>
+__aicore__ inline bool SparseFlashAttentionKernelMla<CubeBlockType, VecBlockType>::CanBalanceDecode(
+    __gm__ uint8_t* sinks)
+{
+    using namespace SFABalancedDecode;
+    if constexpr (SFAVectorService<TEMPLATE_INTF_ARGS>::CAN_USE_DIRECT_KV_L1 &&
+                  IsSameType<Q_T, bfloat16_t>::value) {
+        if (GetBlockNum() != CORES ||
+            sfaConstInfo.gSize != HEADS || sfaConstInfo.n2Size != 1 ||
+            sfaConstInfo.sparseBlockCount != INDEX_COUNT || sfaConstInfo.sparseBlockSize != 1 ||
+            sfaConstInfo.sparseMode != 3 || sharedParams.blockSize != TILE_ROWS ||
+            sharedParams.returnSoftmaxLse || sinks != nullptr || actualSeqQlenAddr == nullptr ||
+            actualSeqKvlenAddr == nullptr || sparseIndicesAddr == nullptr) {
+            return false;
+        }
+        // A batch can contain unequal query and KV lengths. The earliest query
+        // of every nonempty request must see a full 2048-index window.
+        int32_t previousEnd = 0;
+        for (uint32_t batch = 0; batch < sfaConstInfo.bSize; ++batch) {
+            const int32_t end = actualSeqQlenAddr[batch];
+            if (end < previousEnd || end > static_cast<int32_t>(sfaConstInfo.s1Size) ||
+                (end > previousEnd && actualSeqKvlenAddr[batch] <
+                 static_cast<int32_t>(INDEX_COUNT) + end - previousEnd - 1)) {
+                return false;
+            }
+            previousEnd = end;
+        }
+        balancedQueries = previousEnd;
+        if (!HasUsefulTileBudget(balancedQueries)) {
+            return false;
+        }
+        for (uint32_t query = 0; query < balancedQueries; ++query) {
+            if (sparseIndicesAddr[(static_cast<uint64_t>(query) + 1) * INDEX_COUNT - 1] < 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+    return false;
+}
