+TEMPLATES_DEF_NO_DEFAULT
+__aicore__ inline void SFAVectorService<TEMPLATE_ARGS>::MergeBalancedQuery(
+    __gm__ float* partialWorkspace, uint32_t query, ConstInfo& constInfo, uint32_t coreCapacity,
+    uint32_t parts, uint32_t statsBank, mm2ResPos& bmm2Scratch)
+{
+    using namespace SFABalancedDecode;
+    GlobalTensor<float> workspace;
+    workspace.SetGlobalBuffer(partialWorkspace);
+    const uint32_t owner = static_cast<uint64_t>(query) * TILES_PER_QUERY / coreCapacity;
+    WaitFlag<HardEvent::MTE3_V>(mte3ToVAttnOutId);
+    WaitFlag<HardEvent::MTE3_MTE2>(mte3ToMte2[0]);
+    // Final Vec2 has consumed the Cube result; fence those reads before reusing its UB.
+    const auto vToMte2 = GetTPipePtr()->FetchEventID(HardEvent::V_MTE2);
+    SetFlag<HardEvent::V_MTE2>(vToMte2);
+    WaitFlag<HardEvent::V_MTE2>(vToMte2);
+
+    LocalTensor<float> stats = stage0OutBuf[0].template Get<float>();
+    DataCopy(stats, softmaxMaxBuf[statsBank].template Get<float>(), HEADS);
+    DataCopy(stats[HEADS], softmaxSumBuf[statsBank].template Get<float>(), HEADS);
+    for (uint32_t part = 1; part < parts; ++part) {
+        const uint64_t offset = static_cast<uint64_t>(RemotePartialSlot(owner + part, coreCapacity)) * PARTIAL_ELEMENTS;
+        DataCopy(stats[2 * part * HEADS], workspace[offset + MAX_OFFSET],
+                 2 * HEADS);
+    }
+    SetFlag<HardEvent::MTE2_V>(mte2ToV);
+    WaitFlag<HardEvent::MTE2_V>(mte2ToV);
+    PipeBarrier<PIPE_V>();
+    auto weights = reinterpret_cast<__ubuf__ float*>(stats.GetPhyAddr());
+    if (parts == THREE_PARTS) {
+        ComputeThreePartMergeWeights(weights);
+    } else {
+        ComputeTwoPartMergeWeights(weights);
+    }
+    PipeBarrier<PIPE_V>();
+
+    LocalTensor<float> output = stage2OutBuf.template Get<float>();
+    LocalTensor<float> remote = bmm2Scratch.template GetTensor<float>();
+    for (uint32_t part = 1; part < parts; ++part) {
+        if (part > 1) {
+            SetFlag<HardEvent::V_MTE2>(vToMte2);
+            WaitFlag<HardEvent::V_MTE2>(vToMte2);
+        }
+        const uint64_t offset = static_cast<uint64_t>(RemotePartialSlot(owner + part, coreCapacity)) * PARTIAL_ELEMENTS;
+        DataCopy(remote, workspace[offset], OUTPUT_ELEMENTS);
+        SetFlag<HardEvent::MTE2_V>(mte2ToV);
+        WaitFlag<HardEvent::MTE2_V>(mte2ToV);
+        auto localData = reinterpret_cast<__ubuf__ float*>(output.GetPhyAddr());
+        auto peerData = reinterpret_cast<__ubuf__ float*>(remote.GetPhyAddr());
+        if (part == 1) {
+            MergeTwoPartRows(localData, peerData, weights, weights + HEADS, HEADS);
+        } else {
+            AccumulateBalancedRows(localData, peerData, weights + part * HEADS);
+        }
+        PipeBarrier<PIPE_V>();
+    }
+    RunInfo outputInfo{};
+    outputInfo.attentionOutOffset = static_cast<int64_t>(query) * OUTPUT_ELEMENTS;
+    outputInfo.vec2MRealSize = HEADS;
+    CopyOutAttentionOut(outputInfo, constInfo, output, 0, OUTPUT_ELEMENTS);
+    SetFlag<HardEvent::MTE3_MTE2>(mte3ToMte2[0]);
+    SetFlag<HardEvent::MTE3_V>(mte3ToVAttnOutId);
+}
