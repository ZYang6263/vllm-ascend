+__simd_vf__ inline void ComputeThreePartMergeWeights(__ubuf__ float* stats)
+{
+    constexpr uint32_t heads = SFABalancedDecode::HEADS;
+    Reg::RegTensor<float> maxima[3];
+    Reg::RegTensor<float> sums[3];
+    Reg::RegTensor<float> globalMax;
+    Reg::RegTensor<float> denominator;
+    Reg::MaskReg all = Reg::CreateMask<float, Reg::MaskPattern::ALL>();
+#pragma unroll
+    for (uint32_t part = 0; part < 3; ++part) {
+        Reg::LoadAlign(maxima[part], stats + (2 * part) * heads);
+        Reg::LoadAlign(sums[part], stats + (2 * part + 1) * heads);
+    }
+    Reg::Max(globalMax, maxima[0], maxima[1], all);
+    Reg::Max(globalMax, globalMax, maxima[2], all);
+#pragma unroll
+    for (uint32_t part = 0; part < 3; ++part) {
+        Reg::Sub(maxima[part], maxima[part], globalMax, all);
+        Reg::Exp(maxima[part], maxima[part], all);
+        Reg::Mul(sums[part], sums[part], maxima[part], all);
+    }
+    Reg::Add(denominator, sums[0], sums[1], all);
+    Reg::Add(denominator, denominator, sums[2], all);
+#pragma unroll
+    for (uint32_t part = 0; part < 3; ++part) {
+        Reg::Div(sums[part], sums[part], denominator, all);
+        Reg::StoreAlign<float, Reg::StoreDist::DIST_NORM_B32>(stats + part * heads, sums[part], all);
+    }
+}
+
+__simd_vf__ inline void MergeThreePartRows(__ubuf__ float* data, __ubuf__ float* weights, uint16_t firstRow)
+{
+    constexpr uint32_t rowsPerChunk = 16;
+    constexpr uint32_t dim = SFABalancedDecode::HEAD_DIM;
+    constexpr uint32_t chunkElements = rowsPerChunk * dim;
+    constexpr uint32_t registerElements = 64;
+    Reg::MaskReg all = Reg::CreateMask<float, Reg::MaskPattern::ALL>();
+    Reg::RegTensor<float> w[3];
+    Reg::RegTensor<float> v[3];
+    for (uint16_t row = 0; row < rowsPerChunk; ++row) {
+#pragma unroll
+        for (uint32_t part = 0; part < 3; ++part) {
+            Reg::LoadAlign<float, Reg::LoadDist::DIST_BRC_B32>(w[part],
+                weights + part * SFABalancedDecode::HEADS + firstRow + row);
+        }
+        for (uint16_t col = 0; col < dim; col += registerElements) {
+            const uint32_t offset = row * dim + col;
+#pragma unroll
+            for (uint32_t part = 0; part < 3; ++part) {
+                Reg::LoadAlign(v[part], data + part * chunkElements + offset);
+                Reg::Mul(v[part], v[part], w[part], all);
+            }
+            Reg::Add(v[0], v[0], v[1], all);
+            Reg::Add(v[0], v[0], v[2], all);
+            Reg::StoreAlign<float, Reg::StoreDist::DIST_NORM_B32>(data + offset, v[0], all);
+        }
+    }
+}
+
+__simd_vf__ inline void ComputeTwoPartMergeWeights(__ubuf__ float* stats)
+{
+    Reg::RegTensor<float> max0;
+    Reg::RegTensor<float> max1;
+    Reg::RegTensor<float> sum0;
+    Reg::RegTensor<float> sum1;
+    Reg::RegTensor<float> globalMax;
+    Reg::RegTensor<float> denominator;
+    Reg::MaskReg all = Reg::CreateMask<float, Reg::MaskPattern::ALL>();
+
+    Reg::LoadAlign(max0, stats);
+    Reg::LoadAlign(sum0, stats + SFABalancedDecode::HEADS);
+    Reg::LoadAlign(max1, stats + 2 * SFABalancedDecode::HEADS);
+    Reg::LoadAlign(sum1, stats + 3 * SFABalancedDecode::HEADS);
+    Reg::Max(globalMax, max0, max1, all);
+    Reg::Sub(max0, max0, globalMax, all);
+    Reg::Sub(max1, max1, globalMax, all);
+    Reg::Exp(max0, max0, all);
+    Reg::Exp(max1, max1, all);
+    Reg::Mul(sum0, sum0, max0, all);
+    Reg::Mul(sum1, sum1, max1, all);
+    Reg::Add(denominator, sum0, sum1, all);
+    Reg::Div(sum0, sum0, denominator, all);
+    Reg::Div(sum1, sum1, denominator, all);
+    Reg::StoreAlign<float, Reg::StoreDist::DIST_NORM_B32>(stats, sum0, all);
+    Reg::StoreAlign<float, Reg::StoreDist::DIST_NORM_B32>(stats + SFABalancedDecode::HEADS, sum1, all);
+}
+
+__simd_vf__ inline void MergeTwoPartRows(__ubuf__ float* left, __ubuf__ float* right,
+                                          __ubuf__ float* weight0, __ubuf__ float* weight1, uint16_t rows)
+{
+    constexpr uint16_t registerElements = 64;
+    Reg::RegTensor<float> leftValue;
+    Reg::RegTensor<float> rightValue;
+    Reg::RegTensor<float> leftWeight;
+    Reg::RegTensor<float> rightWeight;
+    Reg::MaskReg all = Reg::CreateMask<float, Reg::MaskPattern::ALL>();
+    for (uint16_t row = 0; row < rows; ++row) {
+        Reg::LoadAlign<float, Reg::LoadDist::DIST_BRC_B32>(leftWeight, weight0 + row);
+        Reg::LoadAlign<float, Reg::LoadDist::DIST_BRC_B32>(rightWeight, weight1 + row);
+        for (uint16_t col = 0; col < SFABalancedDecode::HEAD_DIM; col += registerElements) {
+            uint32_t offset = row * SFABalancedDecode::HEAD_DIM + col;
+            Reg::LoadAlign(leftValue, left + offset);
+            Reg::LoadAlign(rightValue, right + offset);
+            Reg::Mul(leftValue, leftValue, leftWeight, all);
+            Reg::Mul(rightValue, rightValue, rightWeight, all);
+            Reg::Add(leftValue, leftValue, rightValue, all);
+            Reg::StoreAlign<float, Reg::StoreDist::DIST_NORM_B32>(left + offset, leftValue, all);
+        }
+    }
+}
+
+__simd_vf__ inline void AccumulateBalancedRows(__ubuf__ float* output, __ubuf__ float* peer,
+                                              __ubuf__ float* peerWeights)
+{
+    constexpr uint16_t registerElements = 64;
+    Reg::RegTensor<float> current;
+    Reg::RegTensor<float> other;
+    Reg::RegTensor<float> weight;
+    Reg::MaskReg all = Reg::CreateMask<float, Reg::MaskPattern::ALL>();
+    for (uint16_t row = 0; row < SFABalancedDecode::HEADS; ++row) {
+        Reg::LoadAlign<float, Reg::LoadDist::DIST_BRC_B32>(weight, peerWeights + row);
+        for (uint16_t col = 0; col < SFABalancedDecode::HEAD_DIM; col += registerElements) {
+            const uint32_t offset = row * SFABalancedDecode::HEAD_DIM + col;
+            Reg::LoadAlign(current, output + offset);
+            Reg::LoadAlign(other, peer + offset);
+            Reg::Mul(other, other, weight, all);
+            Reg::Add(current, current, other, all);
+            Reg::StoreAlign<float, Reg::StoreDist::DIST_NORM_B32>(output + offset, current, all);
+        }
+    }
+}
