+#ifndef SPARSE_FLASH_ATTENTION_Q48_BALANCE_H
+#define SPARSE_FLASH_ATTENTION_Q48_BALANCE_H
+
+#include <cstdint>
+
+#if defined(__CCE_AICORE__)
+#define SFA_BALANCE_INLINE __aicore__ inline
+#else
+#define SFA_BALANCE_INLINE inline
+#endif
+
+namespace SFABalancedDecode {
+constexpr uint32_t CORES = 64;
+constexpr uint32_t HEADS = 64;
+constexpr uint32_t HEAD_DIM = 512;
+constexpr uint32_t TWO_PARTS = 2;
+constexpr uint32_t THREE_PARTS = 3;
+constexpr uint32_t TILE_ROWS = 128;
+constexpr uint32_t TILES_PER_QUERY = 16;
+constexpr uint32_t MIN_TILES_SAVED_PER_CORE = 4;
+constexpr uint32_t INDEX_COUNT = TILES_PER_QUERY * TILE_ROWS;
+constexpr uint32_t OUTPUT_ELEMENTS = HEADS * HEAD_DIM;
+constexpr uint32_t MAX_OFFSET = OUTPUT_ELEMENTS;
+constexpr uint32_t SUM_OFFSET = MAX_OFFSET + HEADS;
+constexpr uint32_t PARTIAL_ELEMENTS = SUM_OFFSET + HEADS;
+
+SFA_BALANCE_INLINE constexpr uint32_t TilesPerCore(uint32_t queries)
+{
+    const uint32_t balancedTiles = (static_cast<uint64_t>(queries) * TILES_PER_QUERY + CORES - 1) / CORES;
+    // Small workloads use two cores per query instead of creating four-way merges.
+    return balancedTiles < TILES_PER_QUERY / 2 ? TILES_PER_QUERY / 2 : balancedTiles;
+}
+
+SFA_BALANCE_INLINE constexpr bool HasUsefulTileBudget(uint32_t queries)
+{
+    if (queries == 0) {
+        return false;
+    }
+    const uint32_t coreTiles = TilesPerCore(queries);
+    const uint32_t originalTiles = ((static_cast<uint64_t>(queries) + CORES - 1) / CORES) * TILES_PER_QUERY;
+    // Compare critical-path work, including query counts larger than the core count.
+    return coreTiles + MIN_TILES_SAVED_PER_CORE <= originalTiles;
+}
+
+SFA_BALANCE_INLINE constexpr uint32_t PartsPerQuery(uint32_t coreTiles)
+{
+    // The largest query start offset is coreTiles minus gcd(coreTiles, TILES_PER_QUERY).
+    uint32_t a = coreTiles;
+    uint32_t b = TILES_PER_QUERY;
+    while (b != 0) {
+        const uint32_t remainder = a % b;
+        a = b;
+        b = remainder;
+    }
+    return 1 + (coreTiles - a + TILES_PER_QUERY - 1) / coreTiles;
+}
+
+SFA_BALANCE_INLINE constexpr uint64_t WorkspaceBytes(uint32_t queries)
+{
+    // Each core can produce at most one remote fragment. Reserve for any
+    // actual Q up to the tensor capacity, including graph padding.
+    const uint32_t slots = queries <= CORES / 2 ? queries : CORES - CORES / TILES_PER_QUERY;
+    return static_cast<uint64_t>(slots) * PARTIAL_ELEMENTS * sizeof(float);
+}
+
+SFA_BALANCE_INLINE constexpr uint32_t RemotePartialSlot(uint32_t core, uint32_t coreTiles)
+{
+    uint32_t a = coreTiles;
+    uint32_t b = TILES_PER_QUERY;
+    while (b != 0) {
+        const uint32_t remainder = a % b;
+        a = b;
+        b = remainder;
+    }
+    const uint32_t alignmentPeriod = TILES_PER_QUERY / a;
+    return core == 0 ? 0 : core - 1 - (core - 1) / alignmentPeriod;
+}
+} // namespace SFABalancedDecode
+
+#undef SFA_BALANCE_INLINE
+
+#endif // SPARSE_FLASH_ATTENTION_Q48_BALANCE_H
