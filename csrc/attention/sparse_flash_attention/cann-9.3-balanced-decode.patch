+    WaitFlag<HardEvent::V_MTE3>(vToMte3AttnOutId);
+    DataCopy(splitS2Gm[splitS2Slot], partialFp32, SFABalancedDecode::OUTPUT_ELEMENTS);
+    DataCopy(splitS2Gm[splitS2Slot + SFABalancedDecode::MAX_OFFSET], maxUb, SFABalancedDecode::HEADS);
+    DataCopy(splitS2Gm[splitS2Slot + SFABalancedDecode::SUM_OFFSET], sumUb, SFABalancedDecode::HEADS);
+}
